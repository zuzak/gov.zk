{
  "main": "server.js",
  "name": "gov.zk",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run lint && npm run mocha",
    "mocha": "NODE_ENV='test' mocha test/*.js",
    "coverage": "NODE_ENV='test' c8 mocha -- -R spec",
    "validate": "npm ls",
    "lint": "standard --verbose",
    "build": "node_modules/dart-sass/sass.js -I node_modules/govuk_frontend_toolkit/stylesheets/ -I node_modules/govuk-elements-sass/public/sass/ public",
    "prestart": "node_modules/dart-sass/sass.js -I node_modules/govuk_frontend_toolkit/stylesheets/ -I node_modules/govuk-elements-sass/public/sass/ public"
  },
  "devDependencies": {
    "c8": "^9.0.0",
    "dart-sass": "^1.25.0",
    "mocha": "^10.0.0",
    "recursive-readdir-sync": "^1.0.6",
    "should": "^13.0.0",
    "standard": "^17.0.0",
    "supertest": "^6.0.0"
  },
  "dependencies": {
    "ansi_up": "^4.0.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "credits-to": "0.0.2",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-list-endpoints": "^7.0.0",
    "express-session": "^1.18.0",
    "express-session-json": "0.0.8",
    "git-state": "^4.0.0",
    "githash": "0.0.4",
    "govuk-elements-sass": "^3.0.2",
    "govuk_frontend_toolkit": "^5.2.0",
    "hat": "0.0.3",
    "html-escape": "^2.0.0",
    "i18n": "^0.15.0",
    "irc": "^0.5.2",
    "librcon": "^1.0.3",
    "node-isbn": "^1.6.1",
    "passport": "^0.7.0",
    "pug": "^3.0.0",
    "select-random-file": "^1.1.0",
    "shuffle-array": "^1.0.1",
    "sort-object": "^3.0.2"
  },
  "private": true,
  "bugs": {
    "url": "https://github.com/zuzak/gov.zk/issues"
  },
  "license": "MIT",
  "repository": "zuzak/gov.zk",
  "standard": {
    "globals": [
      "__",
      "__l",
      "__h",
      "getCatalog",
      "getLocale",
      "t"
    ]
  }
}
